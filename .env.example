# --- TMDB (Required) ---
# Get a TMDB API read token/key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Search Fallback (Recommended) ---
# Tavily helps find difficult titles, but returned IDs are still verified by TMDB.
TAVILY_API_KEY=

# --- Auxiliary Metadata (Optional) ---
OMDB_API_KEY=

# --- Proxy Settings (Optional) ---
# Use these only if your network needs a proxy for TMDB/Tavily requests.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# --- LLM for Translation (Optional) ---
# If not set, metadata will use the source language returned by providers.
# Compatible with OpenAI-style endpoints such as LocalAI, vLLM, and similar services.
MODEL_BASE_URL=http://127.0.0.1:8045/v1
MODEL_API_KEY=EMPTY
MODEL_NAME=gemini-3-flash
