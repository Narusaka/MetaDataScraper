# --- TMDB (Required) ---
# Get your key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Optional Search Fallbacks ---
# Used if TMDB Search fails
OMDB_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Tavily is used for AI-powered fuzzy search
TAVILY_API_KEY=

# --- Proxy Settings (Optional) ---
# If you are in a region where TMDB/Google is blocked
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# --- LLM for Translation (Optional) ---
# If not set, metadata will use original language (English/Chinese mixed)
# Compatible with OpenAI-style endpoints (LocalAI, vLLM, etc.)
MODEL_BASE_URL=http://127.0.0.1:8045/v1
MODEL_API_KEY=EMPTY
MODEL_NAME=gemini-3-flash
